<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>JellyWatchParty.Plugin</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.12.15.0</Version>
    <AssemblyVersion>1.12.15.0</AssemblyVersion>
    <FileVersion>1.12.15.0</FileVersion>
    <Authors>TIGamingTV; Ruslan Veselov</Authors>
    <Description>Watch movies together in sync with friends on Jellyfin</Description>
    <RepositoryUrl>https://github.com/rakkateichou/JellyWatchParty</RepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JellyWatchParty.Tests" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.11" ExcludeAssets="runtime" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.35.0" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="6.35.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\configPage.html" />
    <EmbeddedResource Include="..\..\..\clients\jellyfin-web\client-modules.json" LogicalName="JellyWatchParty.Plugin.Web.client-modules.json" />
    <EmbeddedResource Include="..\..\..\clients\jellyfin-web\invite-bootstrap.html" LogicalName="JellyWatchParty.Plugin.Web.invite-bootstrap.html" />
    <EmbeddedResource Include="..\..\..\clients\jellyfin-web\**\*.js" Exclude="..\..\..\clients\jellyfin-web\tests\**" Link="Web\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\clients\jellyfin-web\assets\**\*.webp" Link="Web\assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
